{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "prospector-sites",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./sites",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash"
  }
}
